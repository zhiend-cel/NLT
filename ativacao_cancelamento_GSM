import pandas as pd
from tqdm import tqdm
import glob
import os
import time
import re
import tkinter as tk
from tkinter import filedialog
import warnings
import gc

warnings.simplefilter(action='ignore', category=UserWarning)
warnings.simplefilter(action='ignore', category=FutureWarning)
warnings.simplefilter('ignore', category=pd.errors.DtypeWarning)

colunas_usadas = ['msisdn', 'data_ativacao', 'fase', 'cliente']

os.system('cls' if os.name =='nt' else 'clear')

def extrair_datanome(nome_arquivo):

	nome = str(nome_arquivo)
	
	match_completo = re.search(r"(\d{1,2})[-._](\d{1,2})[-._](\d{4})", nome)
	if match_completo:
		dia, mes, ano = match_completo.groups()
		return f"{ano}-{mes.zfill(2)}-{dia.zfill(2)}"
	
	match_mensal = re.search(r"(\d{2})_(\d{4})", str(nome_arquivo))
	if match_mensal:
		mes, ano = match_mensal.groups()
		return f"{ano}-{mes.zfill(2)}-01"
	
	return nome

def ler_csv_int(caminho_arquivo):
	encodings = ['utf-8-sig', 'latin1', 'cp1252', 'iso-8859-1']
	separadores = [';', ',']
	
	for enc in encodings:
		for sep in separadores:
			try:
				df_teste = pd.read_csv(caminho_arquivo, sep=sep, encoding=enc, nrows=5)
				if len(df_teste.columns) > 1:
					return pd.read_csv(caminho_arquivo, sep=sep, encoding=enc, on_bad_lines='skip', dtype=str)
			except:
				continue
	return None

def main():
	print("="*90)
	print("		Gerador dos Relatórios de Ativações e Cancelamentos - GSM")
	print("="*90)
	
	root = tk.Tk()
	root.withdraw()
	root.attributes('-topmost', True)

	print("\n Aguardando seleção da pasta...")
	caminho_fechamentos = filedialog.askdirectory(title="Selecione a pasta Fechamentos")

	if not caminho_fechamentos:
		print("Operação cancelada.")
		return

	print(f"\n Pasta selecionada: {caminho_fechamentos}")

	try:
		os.chdir(caminho_fechamentos)
	except FileNotFoundError:
		print("\n Erro: Pasta não encontrada. Verifique o caminho.")
		input("Pressione ENTER para sair.")
		return
	
	# Listar os arquivos

	arquivos = sorted(glob.glob("*.csv"))
	if not arquivos:
		print("\n Nenhum arquivo .csv na pasta. Verifique o caminho.")
		input("Pressione ENTER para sair.")
		return
		
	print(f"\n Encontrados {len(arquivos)} arquivos. Iniciando processamento...")

	lista_dfs = []
	
	# Loop de leitura
	
	for arquivo in tqdm(arquivos, desc="Lendo arquivos.", unit="arq"):
		
		try:			
			df_temp = ler_csv_int(arquivo)
			
			if df_temp is None:
				tqdm.write(f"	Erro, não consegui ler {arquivo} (formato desconhecido).")
				continue
			
			df_temp.columns = df_temp.columns.str.lower().str.strip()
			
			df_temp.rename(columns={
			'data_de_ativacao': 'data_ativacao',
			'data_ativacao (data e hora)': 'data_ativacao',
			'dt_ativacao': 'data_ativacao'
			}, inplace=True)

			cols_existentes = [c for c in colunas_usadas if c in df_temp.columns]
			if 'msisdn' not in cols_existentes:
				continue
			
			df_temp = df_temp[cols_existentes].copy()
			if 'msisdn' in df_temp.columns:
				df_temp['msisdn'] = df_temp['msisdn'].str.replace(r'\.0$', '', regex=True)

			if 'data_ativacao' in df_temp.columns:
				series_data = df_temp['data_ativacao'].astype(str)

				tem_barra = series_data.str.contains('/', regex=False).any()

				if tem_barra:
					df_temp['data_ativacao'] = pd.to_datetime(series_data, dayfirst=True, errors='coerce').dt.date
				else:
					df_temp['data_ativacao'] = pd.to_datetime(series_data, dayfirst=False, errors='coerce').dt.date

			df_temp['arquivo_origem'] = arquivo
			df_temp['indice_leitura'] = len(lista_dfs)

			for col in ['fase', 'cliente', 'arquivo_origem']:
				if col in df_temp.columns:
					df_temp[col] = df_temp[col].astype('category')

			lista_dfs.append(df_temp)
		
		except Exception:
			pass
		
	if not lista_dfs:
		print("Nenhum dado válido carregado.")
		return
	
	print("\nIniciando processamento...")
	
	with tqdm(total=7, desc="Etapas", unit="passo") as pbar:
	
		pbar.set_description("\nConsolidando Tabelas...")
		df = pd.concat(lista_dfs, ignore_index=True)

		del lista_dfs
		gc.collect()
		pbar.update(1)
		
		# Lógica de comparação Cancelamentos
		
		pbar.set_description("\nCalculando Cancelamentos...")
		
		pbar.set_description("\nCalculando Cancelamentos...")
		
		df.sort_values(by=['msisdn', 'indice_leitura'], inplace=True)
		
		df['fase_anterior'] = df.groupby('msisdn')['fase'].shift(1)
		
		mask_cancel = (df['fase_anterior'].astype(str) == 'Vinculado') & (df['fase'] == 'Quarentena')
		df_cancelados = df[mask_cancel].copy()

		del df['fase_anterior']
		gc.collect()
		
		pbar.update(1)
		
		pbar.set_description("\nSalvando Relatório de Cancelamentos...")
		
		df_calc_final = pd.DataFrame()	

		if not df_cancelados.empty:

			df_calc_final = df_cancelados.groupby(['cliente', 'arquivo_origem'])['msisdn'].count().reset_index()
			df_calc_final.rename(columns={'arquivo_origem':'Data', 'msisdn': 'Cancelamentos_calc'}, inplace=True)

			df_calc_final['Data']= df_calc_final['Data'].apply(extrair_datanome)
			df_calc_final['Data']= pd.to_datetime(df_calc_final['Data'], errors='coerce')


			df_calc_final['Data'] = df_calc_final['Data'].dt.to_period('M').dt.to_timestamp() - pd.Timedelta(days=1)
			df_calc_final['Data'] = df_calc_final['Data'].dt.date

		print("\n" + "-"*90)
		tqdm.write("Selecione a tabela de Churn.")
		arq_quarentena = filedialog.askopenfilename(title="Selelecione a planilha Churn.")

		df_quar_final = pd.DataFrame()

		if arq_quarentena:
			try:
				df_quar = ler_csv_int(arq_quarentena)
				if df_quar is not None:
					df_quar.columns = df_quar.columns.str.lower().str.strip()

					col_remap = {
						'nome': 'fase',
						'name': 'cliente'
					}
					df_quar.rename(columns=col_remap, inplace=True)
					
					col_data = 'data_fase'
					cols_quar = df_quar.columns

					if col_data not in cols_quar:
						potenciais = [c for c in cols_quar if 'data' in c or 'dt' in c]
						if potenciais:
							col_data = potenciais[0]

					if 'fase' in cols_quar and col_data in cols_quar:
						df_quar = df_quar[df_quar['fase'].astype(str).str.contains("Quarentena", case=False, na=False)]
						df_quar[col_data] = pd.to_datetime(df_quar[col_data], yearfirst=True, errors='coerce').dt.date
						df_quar_final = df_quar.groupby(['cliente', col_data])['msisdn'].count().reset_index() 	
						df_quar_final.rename(columns={col_data: 'Data', 'msisdn': 'Cancelamentos_planilha'}, inplace=True)
					else: 	
						tqdm.write(f"Aviso: colunas necessárias não encontradas em {os.path.basename(arq_quarentena)}")
			except Exception as e:
				tqdm.write(f"Erro ao ler arquivo: {e}")

		if not df_calc_final.empty and 'Data' in df_calc_final.columns:
			df_calc_final['Data'] = pd.to_datetime(df_calc_final['Data'], errors='coerce')
		if not df_quar_final.empty and 'Data' in df_quar_final.columns:
			df_quar_final['Data'] = pd.to_datetime(df_quar_final['Data'], errors='coerce')


		if not 	df_calc_final.empty and not df_quar_final.empty:
			relatorio_cancelamentos = pd.merge(df_calc_final, df_quar_final, on=['cliente', 'Data'], how='outer')
		elif not df_calc_final.empty:
			relatorio_cancelamentos = df_calc_final
		elif not df_quar_final.empty:
			relatorio_cancelamentos = df_quar_final
		else:
			relatorio_cancelamentos = pd.DataFrame()

		if not relatorio_cancelamentos.empty:
			relatorio_cancelamentos.fillna(0, inplace=True)
			if 'Cancelamentos_calc' not in relatorio_cancelamentos.columns:
				relatorio_cancelamentos['Cancelamentos_calc'] = 0
			if 'Cancelamentos_planilha' not in relatorio_cancelamentos.columns:
				relatorio_cancelamentos['Cancelamentos_planilha'] = 0

			relatorio_cancelamentos['Total_canc'] = (
				relatorio_cancelamentos['Cancelamentos_calc'] +
				relatorio_cancelamentos['Cancelamentos_planilha']
			)

			cols_num = ['Cancelamentos_calc', 'Cancelamentos_planilha', 'Total_canc']
			for c in cols_num:
				if c in relatorio_cancelamentos.columns:
					relatorio_cancelamentos[c] = relatorio_cancelamentos[c].astype(int)

			relatorio_cancelamentos.sort_values(by=['cliente', 'Data'], inplace=True)
			relatorio_cancelamentos['Data'] = pd.to_datetime(relatorio_cancelamentos['Data']).dt.date
			relatorio_cancelamentos = relatorio_cancelamentos[['cliente', 'Data', 'Total_canc']]
			relatorio_cancelamentos.to_csv("Relatório_Cancelamentos - GSM.csv", sep=';', index=False, encoding='utf-8-sig')
		
		pbar.update(1)

		pbar.set_description("\nRecuperando datas...")

		df_apenas_ativos = df[df['fase'].astype(str).str.contains("Vinculad", case=False, na=False)].copy()
		df_apenas_ativos['data_ativacao'] = pd.to_datetime(df_apenas_ativos['data_ativacao'], errors='coerce')
		df_apenas_ativos['data_ativacao'] = df_apenas_ativos.groupby(['cliente', 'msisdn'])['data_ativacao'].transform('max')
		df_ativacoes = df_apenas_ativos.dropna(subset=['data_ativacao']).drop_duplicates(subset=['msisdn'], keep='last').copy()
		df_ativacoes['data_ativacao'] = df_ativacoes['data_ativacao'].dt.date
		
		pbar.set_description("\nSalvando lista detalhada das linhas...")

		cols_save = [c for c in ['cliente', 'msisdn', 'data_ativacao', 'fase'] if c in df_ativacoes.columns]
		lista_detalhada = df_ativacoes[cols_save].copy()
		lista_detalhada.to_csv("Lista_detalhada_ativações.csv", sep=';', index=False, encoding='utf-8-sig')
		
		pbar.update(1)
		
		pbar.set_description("\nFormatando a tabela...")
		
		relatorio_ativacoes = df_ativacoes.groupby(['cliente', 'data_ativacao'])['msisdn'].count().reset_index()
		relatorio_ativacoes.rename(columns={'msisdn': 'Ativações'}, inplace=True)
		
		pbar.update(1)
		
		pbar.set_description("\nSalvando Relatório de Ativações...")	
		
		relatorio_ativacoes.to_csv("Relatório_Ativações - GSM.csv", sep=';', index=False, encoding='utf-8-sig')
		
		pbar.update(1)
	
	print("\n" + "="*90)
	print("		Processo finalizado.")
	print("="*90)



	input("\nPressione ENTER para fechar...")

if __name__ == "__main__":
	main()
